{
  "hosting": {
    "public": "client/dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "senpaiqc-api", "region": "asia-southeast2" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": { "rules": "infra/firestore.rules" }
}
