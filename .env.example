# Local development only. On Cloud Run every secret comes from Secret Manager:
#   GEMINI_API_KEY -> SENPAIQC_GEMINI_API_KEY, DEMO_TOKEN -> SENPAIQC_DEMO_TOKEN (infra/push_secrets.sh)
# Copy to .env. Without GEMINI_API_KEY the app runs with offline adapters and flags everything for a human.
GEMINI_API_KEY=            # put your key in .env (never here); on Cloud Run it comes from Secret Manager
BACKEND=local            # local | gcp
GCP_PROJECT=
GCS_BUCKET=
BQ_DATASET=senpaiqc
YOLO_WEIGHTS=models/best.pt            # path or gs://.../best.pt ; empty = every part escalates
YOLO_LABEL_COUNTS=models/label_counts.json  # file or inline JSON {"IMP-200": 5639}
ROBOT_MODE=false
AUTH_MODE=demo           # demo | firebase
DEMO_TOKEN=senpaiqc-demo
AGENT_URL=    
GEMINI_MODEL= gemini-3.5-flash-lite
ROBOT_MODEL= gemini-robotics-er-2-preview           # empty = run the root-cause agent in-process
